#!/usr/bin/env zsh

# Generates a script that initializes commands requiring extra setup and prints
# it for sourcing. This helper is only meant to be called from init-commands, or
# for debugging.

cat <<EOF
#!/usr/bin/env zsh
# shellcheck shell=bash

#
# Generated by build-init-commands.zsh.
#
# init-commands.zsh: initializes commands that require extra setup in every
# shell. Should be called by ~/.zshrc.
#

EOF

if hash mise >/dev/null 2>&1; then
    printf '# mise\n\n'
    mise activate zsh
    printf '\n'
fi

# @audit completion not working, just lists dirs like cd
if hash zoxide >/dev/null 2>&1; then
    printf '# zoxide (load after compinit, fzf-rc, zsh-autocomplete)\n\n'
    zoxide init zsh
    printf '\n'
fi
